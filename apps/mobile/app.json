{
  "expo": {
    "name": "Tennis Lebanon (Dev)",
    "slug": "tennis-lebanon",
    "scheme": "tennislebanon",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tennislebanon.dev"
    },
    "android": {
      "package": "com.tennislebanon.dev",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Tennis Lebanon to access your photos so you can set a profile picture."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7e52c1bd-5a92-42a0-8b08-ace7d6a96542"
      },
      "router": {}
    },
    "owner": "alimogh"
  }
}
