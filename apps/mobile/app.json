{
  "expo": {
    "name": "Tennis Lebanon (Dev)",
    "slug": "tennis-lebanon",
    "scheme": "tennislebanon",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tennislebanon.dev"
    },
    "android": {
      "package": "com.tennislebanon.dev",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
