{
  "expo": {
    "name": "RacketBound",
    "slug": "tennis-lebanon",
    "scheme": "tennislebanon",
    "version": "0.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7e52c1bd-5a92-42a0-8b08-ace7d6a96542"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.racketbound.app"
    },
    "android": {
      "package": "com.racketbound.app",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow RacketBound to access your photos so you can set a profile picture."
        }
      ],
      "./plugins/with-android-abis"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7e52c1bd-5a92-42a0-8b08-ace7d6a96542"
      },
      "router": {}
    },
    "owner": "alimogh"
  }
}
