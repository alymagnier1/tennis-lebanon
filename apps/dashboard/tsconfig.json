{
  "extends": "../../packages/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "target": "ES2017",
    "allowJs": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@tennis-lebanon/api": ["../../packages/api/src/index.ts"],
      "@tennis-lebanon/types": ["../../packages/types/src/index.ts"],
      "@supabase/supabase-js": [
        "../../packages/api/node_modules/@supabase/supabase-js"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
