{
  "name": "tennis-lebanon",
  "private": true,
  "version": "0.0.0",
  "description": "Tennis Lebanon MVP monorepo (mobile app, club dashboard, shared packages).",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20.19.0 <21.0.0"
  },
  "scripts": {
    "dev": "dotenv -e .env -- turbo run dev",
    "dev:mobile": "dotenv -e .env -- turbo run dev --filter=mobile",
    "dev:dashboard": "dotenv -e .env -- turbo run dev --filter=dashboard",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:start": "supabase start",
    "db:start:lean": "supabase start -x vector,logflare,imgproxy,studio,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db supabase/tests/database --local",
    "db:types": "supabase gen types typescript --local > packages/types/src/database.ts",
    "db:diff": "supabase db diff",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "supabase": "2.109.1",
    "turbo": "2.10.6",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
