{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "dotenv",
        "-e",
        ".env",
        "--",
        "pnpm",
        "--filter",
        "mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "dotenv",
        "-e",
        ".env",
        "--",
        "pnpm",
        "--filter",
        "dashboard",
        "exec",
        "next",
        "dev",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "mobile-web-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "port": 8082
    },
    {
      "name": "mobile-dev-client",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "set NODE_EXTRA_CA_CERTS=%USERPROFILE%\\windows-root-ca.pem && cd /d apps\\mobile && npx expo start --dev-client --port 8081"
      ],
      "port": 8081
    }
  ]
}
