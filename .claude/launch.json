{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "dotenv",
        "-e",
        ".env",
        "--",
        "pnpm",
        "--filter",
        "mobile",
        "exec",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "dashboard",
      "url": "http://localhost:3000"
    }
  ]
}
