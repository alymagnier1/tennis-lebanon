# Copy to .env and fill in local/staging values. Never commit the real .env file.
# Client-safe values only use the EXPO_PUBLIC_ / NEXT_PUBLIC_ prefixes.
# Secret/service keys are server-only and must never ship in mobile or browser bundles.
#
# Staging (EAS / Vercel secrets — not git):
#   APP_ENV=staging
#   SUPABASE_URL=https://rvdzalxavpcijbiikkjz.supabase.co
#   SUPPORT_EMAIL=aly.moghnieh@gmail.com
#   AUTH_REDIRECT_URL=tennislebanon://auth/callback (mobile)
# PostHog is not wired in the client; leave it that way until consent copy is approved.

# --- Supabase (client-safe) ---
# *_SUPABASE_ANON_KEY takes the publishable key (sb_publishable_...) on hosted
# projects; the legacy JWT anon key is being retired (2026-09-25 decision).
# The local CLI stack still prints a JWT anon key, which works the same.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_AUTH_REDIRECT_URL=tennislebanon://auth/callback
NEXT_PUBLIC_AUTH_REDIRECT_URL=http://127.0.0.1:3000/auth/callback

# --- Supabase (server-only, dashboard server components/route handlers only) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Observability (safe to omit locally; Sentry no-ops without a DSN) ---
EXPO_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- App metadata ---
EXPO_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPPORT_EMAIL=support@tennis-lebanon.invalid
NEXT_PUBLIC_SUPPORT_EMAIL=support@tennis-lebanon.invalid

# --- Invite links ---
# Shared invite links are https://<INVITE_BASE_URL>/invite#<token>, served by the
# dashboard's public /invite page. Defaults to https://racketbound.com.
EXPO_PUBLIC_INVITE_BASE_URL=
# The invite page's "Get the app" button (the EAS install page for cohort 1).
# Empty hides the button.
NEXT_PUBLIC_GET_APP_URL=

# --- Push notifications ---
# Expo project id, read by apps/mobile/app.config.ts into extra.eas.projectId.
# Without it the app cannot request a push token, no device_push_tokens rows are
# ever written, and every notification is parked as `no_delivery_channel`.
# Get it from expo.dev (project settings) or by running `eas init` in apps/mobile,
# which writes the id straight into app.json and makes this optional.
# Not a secret: it ships in the app binary.
EAS_PROJECT_ID=

# --- Google sign-in (client-safe) ---
# OAuth client ids from Google Cloud Console. Not secrets: the web id is the
# audience of the Google ID token and ships in the app binary by design.
#
# The WEB id is the one the native SDK and Supabase both need. The Android id
# is never read by this code -- Google matches it server-side from the package
# name plus the signing certificate's SHA-1, which is why a wrong SHA-1 shows
# up as `DEVELOPER_ERROR` and nothing else.
#
# Take the SHA-1 from the EAS keystore AFTER the first build on the current
# package name (`eas credentials --platform android`). The package changed to
# com.racketbound.app, so any fingerprint from an earlier build is stale.
#
# Leave blank to hide the Google button: the app still boots and magic link
# still works.
#
# Do NOT add these to eas.json's `env` block unless you put the real value
# there. A build profile's `env` overrides the EAS environment, so an empty
# string in eas.json would silently win over a value set in the dashboard.
# No Expo config plugin is registered, deliberately. Declared as a bare string
# the plugin runs in Firebase mode and demands `expo.android.googleServicesFile`
# (google-services.json), failing the build. Declared with options it validates
# `iosUrlScheme` and then adds *only* that iOS URL scheme -- it does nothing for
# Android, where autolinking is enough. When adding iOS, register it as:
#   ["@react-native-google-signin/google-signin",
#    { "iosUrlScheme": "com.googleusercontent.apps.<reversed ios client id>" }]
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
