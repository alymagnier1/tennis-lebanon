.env
.env.local
.env.*.local
# Suffixed variants such as `.env.local.off`, which are switched on and off by
# renaming. `apps/mobile/.env.local.off` documented itself as ignored by the
# line above and was not: the suffix falls outside every pattern here, so it
# was one `git add .` from being committed.
.env.local.*

# Never commit local secret dumps
APIS and secrets/
**/APIS-secrets.txt

# Vercel CLI link metadata (project is linked in the dashboard)
.vercel/

# Supabase local runtime state (not the committed config/migrations)
supabase/.branches/
supabase/.temp/

# Local backup drill artifacts
.tmp/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/

# Expo / EAS
*.orig.*
web-build/

# Sentry
.sentryclirc

# Local design reference: Figma Make export and screen captures. Kept out of
# history because it is ~28 MB of PNGs plus a second Vite app with its own
# lockfile, none of which the monorepo builds from.
Figma designs/
Figma-Design-2/

# Agent scratch: plan files written by editor tooling, same category as .vscode.
# Narrowed from `.cursor/` — that also hid rules and skills, which are project
# knowledge rather than scratch and belong in history for the same reason
# `.claude/skills/` does. Only the plans are per-session.
.cursor/plans/

# Cursor MCP config holds provider access tokens; keep it local.
.cursor/mcp.json

# Downloaded OAuth client-secret files. Never commit these.
client_secret*.json
Google Client secrets/
